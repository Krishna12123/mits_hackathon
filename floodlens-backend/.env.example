# ==============================================================================
# FloodLens Backend Environment Configuration Template
# ==============================================================================
# WARNING: Do NOT commit actual secrets or private keys to version control.
# Copy this file to .env for local development and fill in real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Earth Engine (GEE) Authentication Configuration
# ------------------------------------------------------------------------------
# Mode A: Service Account Authentication (Recommended for automated/backend use)
# 1. Create a Service Account in your Google Cloud Console.
# 2. Grant Earth Engine Resource Viewer / Earth Engine User roles.
# 3. Download the private key JSON file and place it in a secure local folder.
# 4. Point EE_SERVICE_ACCOUNT_KEY_FILE to the local path.
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY_FILE=
EE_PROJECT_ID=floodlens-512416

# Mode B: Application Default Credentials (ADC)
# Set EE_USE_ADC=true to initialize using local gcloud / earthengine CLI credentials
# (e.g. from `gcloud auth application-default login` or `earthengine authenticate`).
# If using ADC, leave EE_SERVICE_ACCOUNT_KEY_FILE empty.
EE_USE_ADC=false

# ------------------------------------------------------------------------------
# Server & Database Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./floodlens.db
